<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:3px; padding:6px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid #000;">
      <span style="font-size:13px; font-weight:bold;">CTA &middot; {{ data.rail.stationName }}</span>
      <span style="font-size:11px;">walk {{ data.rail.walkMinutes }}m</span>
    </div>

    {% for line in data.rail.lines %}
    <div style="display:flex; align-items:baseline; gap:8px;">
      <span style="font-size:12px; font-weight:bold; flex:1;">{{ line.route }}</span>
      {% if line.arrivals.size > 0 %}
      {% for a in line.arrivals limit:2 %}
      <span style="font-size:17px; font-weight:bold; line-height:1;">{{ a.minutes }}m</span>
      {% endfor %}
      {% else %}
      <span style="font-size:11px;">--</span>
      {% endif %}
    </div>
    {% endfor %}

    {% for stop in data.bus.stops limit:3 %}
    <div style="display:flex; align-items:baseline; gap:8px;">
      <span style="font-size:12px; font-weight:bold; flex:1;">{{ stop.route }}</span>
      {% if stop.arrivals.size > 0 %}
      {% for a in stop.arrivals limit:2 %}
      <span style="font-size:17px; font-weight:bold; line-height:1;">{{ a.minutes }}m</span>
      {% endfor %}
      {% else %}
      <span style="font-size:11px;">--</span>
      {% endif %}
    </div>
    {% endfor %}

    {% unless data.hasAnyArrivals %}
    <div style="font-size:11px;">No departures right now.</div>
    {% endunless %}
  </div>
</div>
