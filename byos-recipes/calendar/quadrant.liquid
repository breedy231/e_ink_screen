<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:6px; padding:8px; height:100%; text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid #000;">
      <span style="font-size:18px; font-weight:bold;">Today</span>
      {% if data.today.size > 3 %}<span style="font-size:13px;">+{{ data.today.size | minus: 3 }} more</span>{% endif %}
    </div>
    {% if data.today.size == 0 %}
    <div style="font-size:17px;">Nothing scheduled.</div>
    {% endif %}
    {% for e in data.today limit:3 %}
    <div style="font-size:17px; line-height:1.3;"><b>{{ e.time }}</b> {{ e.name | truncate: 22 }}</div>
    {% endfor %}
  </div>
</div>
