<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:12px; padding:14px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:3px solid #000; padding-bottom:5px;">
      <span style="font-size:28px; font-weight:bold;">Front Page</span>
      <span style="font-size:15px;">pulled {{ data.generated | split: 'T' | last | slice: 0, 5 }}</span>
    </div>

    {% if data.lead %}
    <div style="font-size:22px; line-height:1.35; font-weight:bold; border-bottom:2px solid #000; padding-bottom:10px;">
      {{ data.lead | truncate: 150 }}
    </div>
    {% endif %}

    {% for th in data.themes limit:4 %}
    <div style="font-size:25px; font-weight:bold; line-height:1.25;">{{ th.title | truncate: 52 }}</div>
    {% endfor %}

    <div style="margin-top:auto; border-top:2px solid #000; padding-top:5px; font-size:16px;">
      {{ data.alsoCount }} more stories &middot; {{ data.watchCount }} videos
    </div>
  </div>
</div>
