<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:8px; padding:10px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:3px solid #000; padding-bottom:4px;">
      <span style="font-size:22px; font-weight:bold;">Front Page</span>
      <span style="font-size:12px;">pulled {{ data.generated | split: 'T' | last | slice: 0, 5 }}</span>
    </div>

    {% if data.lead %}
    <div style="font-size:14px; line-height:1.35; border-bottom:2px solid #000; padding-bottom:6px;">
      {{ data.lead | truncate: 220 }}
    </div>
    {% endif %}

    <div style="display:flex; flex-wrap:wrap; gap:8px 20px;">
      {% for th in data.themes limit:4 %}
      <div style="flex:1 1 45%; min-width:300px;">
        <div style="font-size:16px; font-weight:bold;">{{ th.title | truncate: 44 }}</div>
        <div style="font-size:12px; line-height:1.3;">{{ th.summary | truncate: 130 }}</div>
        {% if th.items.size > 0 %}
        <div style="font-size:10px;">{% for i in th.items limit:2 %}{{ i.feed }}{% unless forloop.last %} &middot; {% endunless %}{% endfor %}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    <div style="margin-top:auto; border-top:2px solid #000; padding-top:3px; font-size:12px;">
      {{ data.alsoCount }} more stories &middot; {{ data.watchCount }} videos in the Watch bucket
    </div>
  </div>
</div>
