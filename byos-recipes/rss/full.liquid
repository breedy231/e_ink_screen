<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:10px; padding:12px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:3px solid #000; padding-bottom:4px;">
      <span style="font-size:24px; font-weight:bold;">Front Page</span>
      <span style="font-size:13px;">pulled {{ data.generated | split: 'T' | last | slice: 0, 5 }}</span>
    </div>

    {% if data.lead %}
    <div style="font-size:19px; line-height:1.35; font-weight:bold; border-bottom:2px solid #000; padding-bottom:8px;">
      {{ data.lead | truncate: 180 }}
    </div>
    {% endif %}

    {% for th in data.themes limit:4 %}
    <div style="display:flex; gap:12px; align-items:baseline;">
      <span style="font-size:20px; font-weight:bold; line-height:1.25;">{{ th.title | truncate: 64 }}</span>
    </div>
    {% endfor %}

    <div style="margin-top:auto; border-top:2px solid #000; padding-top:4px; font-size:14px;">
      {{ data.alsoCount }} more stories &middot; {{ data.watchCount }} videos
    </div>
  </div>
</div>
