<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:14px; padding:16px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:4px solid #000; padding-bottom:6px;">
      <span style="font-size:34px; font-weight:bold;">Front Page</span>
      <span style="font-size:18px;">pulled {{ data.generated | split: 'T' | last | slice: 0, 5 }}</span>
    </div>

    {% if data.lead %}
    <div style="font-size:26px; line-height:1.35; font-weight:bold; border-bottom:2px solid #000; padding-bottom:12px;">
      {{ data.lead | truncate: 120 }}
    </div>
    {% endif %}

    {% for th in data.themes limit:4 %}
    <div style="font-size:31px; font-weight:bold; line-height:1.25;">{{ th.title | truncate: 44 }}</div>
    {% endfor %}

    <div style="margin-top:auto; border-top:2px solid #000; padding-top:6px; font-size:19px;">
      {{ data.alsoCount }} more stories &middot; {{ data.watchCount }} videos
    </div>
  </div>
</div>
