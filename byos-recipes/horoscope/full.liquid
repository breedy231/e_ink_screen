<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:10px; padding:14px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:4px solid #000; padding-bottom:4px;">
      <span style="font-size:34px; font-weight:bold;">Horoscope{% if data.source == 'fixture' %} <span style="font-size:18px; border:2px solid #000; padding:0 6px;">SAMPLE</span>{% endif %}</span>
      <span style="font-size:20px;">{{ data.dateLabel }}{% if data.stale %} &middot; not today's{% endif %}</span>
    </div>

    <div style="display:flex; gap:12px; align-items:baseline;">
      <span style="font-size:20px; font-weight:bold; white-space:nowrap;{% unless data.moonAlert.clear %} background:#000; color:#fff; padding:0 8px;{% else %} border:2px solid #000; padding:0 6px;{% endunless %}">Moon</span>
      <span style="font-size:22px; line-height:1.2; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">{{ data.moonAlert.text }}</span>
    </div>

    <div style="display:flex; gap:22px; flex:1; min-height:0;">
      {% for s in data.signs limit:2 %}
      <div style="flex:1; display:flex; flex-direction:column; gap:6px; min-width:0;">
        <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid #000;">
          <span style="font-size:30px; font-weight:bold;">{{ s.name }}</span>
          {% if s.rating %}<span style="font-size:20px;">{{ s.rating }}</span>{% endif %}
        </div>
        <div style="font-size:24px; line-height:1.22; display:-webkit-box; -webkit-line-clamp:13; -webkit-box-orient:vertical; overflow:hidden;">{{ s.text }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
