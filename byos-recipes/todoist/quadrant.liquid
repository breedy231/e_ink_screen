<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:4px; padding:6px; height:100%; text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid #000;">
      <span style="font-size:14px; font-weight:bold;">Tasks</span>
      <span style="font-size:11px;">{{ data.counts.total }}{% if data.counts.overdue > 0 %} ({{ data.counts.overdue }} od){% endif %}</span>
    </div>
    {% if data.tasks.size == 0 %}
    <div style="font-size:13px;">All clear.</div>
    {% endif %}
    {% for t in data.tasks limit:4 %}
    <div style="font-size:12px; font-weight:bold;">
      {% if t.isOverdue %}&#9888; {% endif %}{{ t.content | truncate: 30 }}
    </div>
    {% endfor %}
  </div>
</div>
