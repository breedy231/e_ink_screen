<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:8px; padding:10px; height:100%; text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:3px solid #000;">
      <span style="font-size:26px; font-weight:bold;">Tasks</span>
      <span style="font-size:16px;">{{ data.counts.total }}{% if data.counts.overdue > 0 %} &middot; {{ data.counts.overdue }} od{% endif %}</span>
    </div>
    {% if data.tasks.size == 0 %}
    <div style="font-size:24px;">All clear.</div>
    {% endif %}
    {% for t in data.tasks limit:6 %}
    <div style="font-size:24px; font-weight:bold; line-height:1.25;">
      {% if t.isOverdue %}&#9888; {% endif %}{{ t.content | truncate: 20 }}
    </div>
    {% endfor %}
  </div>
</div>
