<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:6px; padding:8px; height:100%; text-align:left;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid #000;">
      <span style="font-size:18px; font-weight:bold;">Tasks</span>
      <span style="font-size:13px;">{{ data.counts.total }}{% if data.counts.overdue > 0 %} &middot; {{ data.counts.overdue }} od{% endif %}</span>
    </div>
    {% if data.tasks.size == 0 %}
    <div style="font-size:17px;">All clear.</div>
    {% endif %}
    {% for t in data.tasks limit:3 %}
    <div style="font-size:17px; font-weight:bold; line-height:1.3;">
      {% if t.isOverdue %}&#9888; {% endif %}{{ t.content | truncate: 24 }}
    </div>
    {% endfor %}
  </div>
</div>
