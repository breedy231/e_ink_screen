<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:4px; padding:8px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid #000; padding-bottom:2px;">
      <span style="font-size:16px; font-weight:bold;">Tasks</span>
      <span style="font-size:12px;">
        {{ data.counts.today }} today{% if data.counts.overdue > 0 %} &middot; {{ data.counts.overdue }} overdue{% endif %}
      </span>
    </div>

    {% if data.tasks.size == 0 %}
    <div style="font-size:15px;">All clear.</div>
    {% endif %}

    <div style="display:flex; gap:24px;">
      <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
        {% for t in data.tasks limit:3 %}
        <div style="display:flex; align-items:baseline; gap:8px; border-bottom:1px solid #000; padding-bottom:2px;">
          {% if t.isOverdue %}
          <span style="font-size:10px; font-weight:bold; border:1px solid #000; padding:0 3px;">OD</span>
          {% elsif t.priority <= 2 %}
          <span style="font-size:10px; font-weight:bold; background:#000; color:#fff; padding:0 4px;">P{{ t.priority }}</span>
          {% endif %}
          <span style="font-size:14px; font-weight:bold; flex:1;">{{ t.content | truncate: 32 }}</span>
          {% if t.time %}<span style="font-size:11px;">{{ t.time }}</span>{% endif %}
        </div>
        {% endfor %}
      </div>
      <div style="flex:1; display:flex; flex-direction:column; gap:4px;">
        {% for t in data.tasks limit:3 offset:3 %}
        <div style="display:flex; align-items:baseline; gap:8px; border-bottom:1px solid #000; padding-bottom:2px;">
          {% if t.isOverdue %}
          <span style="font-size:10px; font-weight:bold; border:1px solid #000; padding:0 3px;">OD</span>
          {% elsif t.priority <= 2 %}
          <span style="font-size:10px; font-weight:bold; background:#000; color:#fff; padding:0 4px;">P{{ t.priority }}</span>
          {% endif %}
          <span style="font-size:14px; font-weight:bold; flex:1;">{{ t.content | truncate: 32 }}</span>
          {% if t.time %}<span style="font-size:11px;">{{ t.time }}</span>{% endif %}
        </div>
        {% endfor %}
        {% if data.counts.total > 6 %}
        <div style="font-size:11px;">+{{ data.counts.total | minus: 6 }} more</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
