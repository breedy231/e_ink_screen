<div class="view view--{{ size }}">
  <div style="display:flex; flex-direction:column; gap:10px; padding:12px; height:100%; text-align:left;">

    <div style="display:flex; justify-content:space-between; align-items:baseline; border-bottom:3px solid #000; padding-bottom:5px;">
      <span style="font-size:26px; font-weight:bold;">Tasks</span>
      <span style="font-size:16px;">
        {{ data.counts.today }} today{% if data.counts.overdue > 0 %} &middot; {{ data.counts.overdue }} overdue{% endif %}
      </span>
    </div>

    {% if data.tasks.size == 0 %}
    <div style="font-size:22px; margin-top:20px;">All clear.</div>
    {% endif %}

    {% for t in data.tasks limit:7 %}
    <div style="display:flex; align-items:baseline; gap:12px; border-bottom:1px solid #000; padding-bottom:5px;">
      {% if t.isOverdue %}
      <span style="font-size:13px; font-weight:bold; border:2px solid #000; padding:0 5px;">OVERDUE</span>
      {% elsif t.priority <= 2 %}
      <span style="font-size:13px; font-weight:bold; background:#000; color:#fff; padding:0 6px;">P{{ t.priority }}</span>
      {% endif %}
      <span style="font-size:20px; font-weight:bold; flex:1;">{{ t.content | truncate: 44 }}</span>
      {% if t.time %}<span style="font-size:16px;">{{ t.time }}</span>{% endif %}
      {% if t.project %}<span style="font-size:14px;">{{ t.project }}</span>{% endif %}
    </div>
    {% endfor %}

    {% if data.counts.total > 7 %}
    <div style="font-size:14px;">+{{ data.counts.total | minus: 7 }} more</div>
    {% endif %}
  </div>
</div>
