# Kindle Dashboard server configuration
# Copy to server/.env and fill in real values. NEVER commit the real .env.
# On the Pi, the systemd unit loads this via EnvironmentFile (see pi/setup-auto-deploy.sh).

# Private iCloud published-calendar URL (contains an auth token — treat as a secret).
# In iCloud Calendar: calendar > Public Calendar > copy link (regenerate by toggling off/on).
CALENDAR_URL=

# Discord webhook for low-battery alerts (optional)
DISCORD_WEBHOOK_URL=

# Kindle root password — used only by dev-machine deploy/stats scripts, not by the Pi server
KINDLE_PASSWORD=

# TRMNL (self-hosted BYOS, e.g. usetrmnl/byos_laravel). See TRMNL_SETUP.md.
# TRMNL_MODE: off (default) | alternate (rotate with the default layout) | only
TRMNL_MODE=off
# Base URL of your BYOS instance, e.g. http://localhost:4711
TRMNL_BASE_URL=
# Virtual device MAC address registered in the BYOS admin UI
TRMNL_DEVICE_MAC=
# Device API key/access token from the BYOS admin UI (secret)
TRMNL_API_KEY=
# How long a fetched TRMNL screen is cached before re-fetching (ms)
TRMNL_CACHE_TTL_MS=600000
# Rotation applied when compositing the 800x480 TRMNL screen onto the 600x800 canvas: cw | ccw
TRMNL_ROTATION=cw
# Slot length (minutes) used to alternate between TRMNL and the default layout
TRMNL_SLOT_MINUTES=15
